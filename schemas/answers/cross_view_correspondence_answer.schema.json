{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "跨视角对应答案",
  "required": [
    "same_entity"
  ],
  "additionalProperties": false,
  "properties": {
    "same_entity": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "insufficient_evidence": {
      "type": "boolean",
      "description": "证据不足时置真，优于强猜（SPEC §25 第 4 条）。"
    }
  }
}