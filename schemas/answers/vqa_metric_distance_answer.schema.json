{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "metric VQA 最近距离答案",
  "required": [
    "object_id",
    "distance_m",
    "unit"
  ],
  "additionalProperties": false,
  "properties": {
    "object_id": {
      "type": "string",
      "pattern": "^<(obj|part|wire|region|route|track|pose)_\\d{3,}>$"
    },
    "distance_m": {
      "type": "number",
      "minimum": 0,
      "description": "米。必须为数值，不接受 '约3米' 一类字符串。"
    },
    "unit": {
      "const": "meter",
      "description": "单位必须显式写出（SPEC §26.2）。"
    },
    "evidence_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}